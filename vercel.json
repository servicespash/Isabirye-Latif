{
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap(.*)",
      "destination": "/sitemap$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
