{
  "rewrites": [
    {
      "source": "/template/template([0-9]+)ref=(.*)",
      "destination": "/template/template$1?ref=$2"
    },
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap(.*)",
      "destination": "/sitemap$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
